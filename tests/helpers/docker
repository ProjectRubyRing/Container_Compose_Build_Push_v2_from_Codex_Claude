#!/usr/bin/env bash

set -uo pipefail

if [ -n "${FAKE_DOCKER_CALLS:-}" ]; then
  printf '%s\n' "$*" >> "$FAKE_DOCKER_CALLS"
fi

fail() {
  printf 'fake docker: unsupported arguments: %s\n' "$*" >&2
  exit 64
}

is_cleaned() {
  [ -n "${FAKE_DOCKER_CLEANED:-}" ] && [ -f "$FAKE_DOCKER_CLEANED" ]
}

# compose stop (SIGTERM) 済みかどうか。停止後は終了処理のログが増える様子を再現する。
is_compose_stopped() {
  [ -n "${FAKE_COMPOSE_SHUTDOWN_MARKER:-}" ] && [ -f "$FAKE_COMPOSE_SHUTDOWN_MARKER" ]
}

if [ "${1:-}" = "compose" ]; then
  shift
  subcommand=""
  for arg in "$@"; do
    case "$arg" in
      version|build|up|logs|ps|down|stop|config)
        subcommand="$arg"
        break
        ;;
    esac
  done

  case "$subcommand" in
    version)
      printf 'Docker Compose version v2.29.0\n'
      ;;
    config)
      if [[ " $* " == *" --services "* ]]; then
        # compose.yml の定義順。コンテナを持たないサービスも含む点が ps との違い。
        for fake_service in ${FAKE_COMPOSE_CONFIG_SERVICES:-${FAKE_COMPOSE_PS_SERVICES:-app}}; do
          printf '%s\n' "$fake_service"
        done
      else
        fake_secret_id="${FAKE_COMPOSE_CONFIG_SECRET_ID:-jboss_master_password}"
        printf 'services:\n'
        printf '  base:\n'
        printf '    build:\n'
        printf '      context: /workspace\n'
        printf '      dockerfile: Dockerfile\n'
        printf '      secrets:\n'
        printf '        - source: %s\n' "$fake_secret_id"
        printf '    image: j1/base.local\n'
        printf 'secrets:\n'
        printf '  %s:\n' "$fake_secret_id"
        printf '    environment: %s\n' "${FAKE_COMPOSE_CONFIG_SECRET_ENV:-JBOSS_MASTER_PASSWORD}"
      fi
      ;;
    build)
      printf '[fake-build] BUILDKIT_PROGRESS=%s\n' "${BUILDKIT_PROGRESS:-unset}"
      if [ "${FAKE_DOCKER_BUILD_ECHO_JBOSS_PASSWORD:-false}" = "true" ]; then
        printf 'fake JBoss CLI input: %s\n' "${JBOSS_MASTER_PASSWORD:-}"
      fi
      if [ -n "${FAKE_DOCKER_BUILD_LOG_FILE:-}" ]; then
        cat "$FAKE_DOCKER_BUILD_LOG_FILE"
      fi
      if [ "${FAKE_DOCKER_BUILD_FAIL:-false}" = "true" ]; then
        printf 'fake compose build failed\n' >&2
        exit 42
      fi
      ;;
    up)
      # 依存サービス (adot collector) の healthcheck 失敗で
      # compose up --wait が失敗する状況の再現。
      if [ "${FAKE_COMPOSE_UP_FAIL:-false}" = "true" ]; then
        printf 'dependency failed to start: container adot-collector is unhealthy\n' >&2
        exit 1
      fi
      printf 'fake app container started\n'
      ;;
    logs)
      # ビルド失敗などでコンテナが 1 つも作られていない状態の再現。
      if [ "${FAKE_COMPOSE_NO_CONTAINERS:-false}" = "true" ]; then
        exit 0
      fi
      if [ -z "${FAKE_COMPOSE_LOG_FILE:-}" ]; then
        printf 'FAKE_COMPOSE_LOG_FILE is not set\n' >&2
        exit 65
      fi
      last_arg="${!#}"
      if [ "$last_arg" = "db" ]; then
        for log_number in $(seq 1 52); do
          printf 'db-1  | DB%03d: companion service log\n' "$log_number"
        done
      elif [ "$last_arg" = "cache" ]; then
        printf 'cache-1  | CACHE001: cache ready\n'
        printf 'cache-1  | CACHE002: accepting connections\n'
      elif [ "$last_arg" = "cwagent" ]; then
        printf 'cwagent  | I! CloudWatch agent started\n'
        printf 'cwagent  | I! Log collection configured\n'
      elif [ "$last_arg" = "adot-collector" ] || [ "$last_arg" = "otel" ]; then
        printf 'adot-collector  | TracesExporter resource spans: 2, spans: 4\n'
        # SIGTERM 受信後は ECS と同じく graceful shutdown のログが追記される。
        if is_compose_stopped; then
          printf 'adot-collector  | info service@v0.102.0/service.go:255 Received signal from OS {"signal": "terminated"}\n'
          printf 'adot-collector  | info extensions/extensions.go:60 Stopping extensions...\n'
          printf 'adot-collector  | info service@v0.102.0/service.go:169 Shutdown complete.\n'
        fi
      else
        cat "$FAKE_COMPOSE_LOG_FILE"
      fi
      ;;
    ps)
      # ps はコンテナを持つサービスだけを返すため、コンテナ未作成時は何も返さない。
      if [ "${FAKE_COMPOSE_NO_CONTAINERS:-false}" = "true" ]; then
        :
      elif [[ " $* " == *" --services "* ]]; then
        for fake_service in ${FAKE_COMPOSE_PS_SERVICES:-app}; do
          printf '%s\n' "$fake_service"
        done
      else
        case "${!#}" in
          cwagent) printf 'cid-cwagent\n' ;;
          cloudwatch-logs-mock) printf 'cid-cloudwatch-logs-mock\n' ;;
          adot-collector|otel) printf 'cid-adot-collector\n' ;;
          jaeger) printf 'cid-jaeger\n' ;;
          mysql80) printf 'cid-mysql80\n' ;;
          aurora84) printf 'cid-mysql84\n' ;;
          nohealth) printf 'cid-nohealth\n' ;;
          *) printf 'cid-app\n' ;;
        esac
      fi
      ;;
    stop)
      if [ -n "${FAKE_COMPOSE_SHUTDOWN_MARKER:-}" ]; then
        : > "$FAKE_COMPOSE_SHUTDOWN_MARKER"
      fi
      printf 'fake app container stopped\n'
      ;;
    down)
      printf 'fake app container removed\n'
      ;;
    *)
      fail "compose $*"
      ;;
  esac
  exit 0
fi

if [ "${1:-}" = "context" ] && [ "${2:-}" = "show" ]; then
  printf 'default\n'
  exit 0
fi

if [ "${1:-}" = "context" ] && [ "${2:-}" = "inspect" ]; then
  printf 'unix:///var/run/docker.sock\n'
  exit 0
fi

if [ "${1:-}" = "create" ]; then
  printf 'cid-jboss-password-diagnostic\n'
  exit 0
fi

if [ "${1:-}" = "cp" ]; then
