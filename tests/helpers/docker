if [ "${1:-}" = "exec" ] && [ "${6:-}" = "healthcheck-file" ]; then
  printf 'ファイル: %s\n' "${7:-/healthcheck}"
  printf '%s\n' '-rwxr-xr-x 1 root root 12345 Jul 24 00:00 /healthcheck'
  printf '実行権限: あり\n'
  printf '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  /healthcheck\n'
  exit 0
fi

if [ "${1:-}" = "exec" ] && [ "${2:-}" = "cid-app" ] \
    && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"curl -fs http://127.0.0.1:8080/health"* ]]; then
  if [ "${FAKE_HEALTHCHECK_EXACT_FAIL:-false}" = "true" ]; then
    exit 22
  fi
  exit 0
fi

if [ "${1:-}" = "exec" ] && [[ "${2:-}" == cid-mysql* ]] \
    && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"command -v mysql"* ]]; then
  exit 0
fi

if [ "${1:-}" = "exec" ] && [ "${2:-}" != "-it" ] \
    && [ "${3:-}" = "/bin/sh" ] && [ "${4:-}" = "-c" ] \
    && [[ "${5:-}" == *"command -v mysql"* ]]; then
  exit 1
fi

if [ "${1:-}" = "exec" ] && [ "${2:-}" = "-it" ] \
    && [[ "${3:-}" == cid-mysql* ]] && [ "${4:-}" = "/bin/sh" ] \
    && [ "${5:-}" = "-c" ]; then
  if [ "${FAKE_MYSQL_CLIENT_FAIL:-false}" = "true" ]; then
    printf 'fake mysql client connection failed\n' >&2
    exit 70
  fi
  case "${3:-}" in
    cid-mysql80) printf 'Welcome to the MySQL monitor.  Server version: 8.0.42\n' ;;
    cid-mysql84) printf 'Welcome to the MySQL monitor.  Server version: 8.4.6\n' ;;
  esac
  exit 0
fi

if [ "${1:-}" = "exec" ] && [ "${2:-}" = "cid-cwagent" ] \
    && [ "${3:-}" = "cat" ] && [ "${4:-}" = "/etc/cwagentconfig/cwagent-config.json" ]; then
  cat <<'JSON'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/mnt/logs/app-front*.log",
