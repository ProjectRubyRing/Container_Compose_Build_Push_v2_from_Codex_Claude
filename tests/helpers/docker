  printf '\037-Djava.net.preferIPv4Stack=true'
  printf '\037-Djboss.modules.system.pkgs=org.jboss.byteman'
  printf '\037-Djboss.password=do-not-log-this-jvm-value'
  printf '\037--add-opens=java.base/java.lang=ALL-UNNAMED'
  printf '\037--add-exports\037java.base/sun.nio.ch=ALL-UNNAMED'
  printf '\037-jar\037/opt/jboss-eap/jboss-modules.jar'
